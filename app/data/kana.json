 "notes": [
  {
   "mark": "っ / ッ",
   "ru": "Маленькое цу: удвоение следующей согласной (пауза). きって kitte, カップ kappu."
  },
  {
   "mark": "ー",
   "ru": "Удлинитель в катакане: コーヒー kōhī, ビール bīru. В ромадзи — макрон."
  },
  {
   "mark": "ん / ン",
   "ru": "Слоговое «н». Перед b/p/m звучит как «м»: さんびゃく «самбяку». Перед гласной в ромадзи — n' (kin'en)."
  },
  {
   "mark": "゛ ゜",
   "ru": "Дакутэн (озвончение: か→が) и handakuten (は→ぱ)."
  },
  {
   "mark": "は / を / へ",
   "ru": "Как частицы читаются wa / o / e."
  }
 ],
